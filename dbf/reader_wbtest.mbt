///|
test "literal deleted character row" {
  let b = b"\x03\x00\x00\x00\x01\x00\x00\x00\x41\x00\x04\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00NAME\x00\x00\x00\x00\x00\x00\x00C\x00\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x0d*abc\x1a"
  let t = read(b)
  assert_eq(t.fields[0].name, "NAME")
  assert_true(t.rows[0].deleted)
  assert_eq(t.rows[0].values[0], Text("abc"))
}
